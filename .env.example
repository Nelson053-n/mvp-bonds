MVP_SQLITE_DB_PATH=data/portfolio.db
MVP_JWT_SECRET=<YOUR_JWT_SECRET>
# Dedicated key for encrypting stored broker (T-Bank) tokens. Kept SEPARATE from
# MVP_JWT_SECRET so rotating the JWT secret never breaks decryption of already
# stored tokens. Leave empty to use a key derived from MVP_JWT_SECRET (backward
# compatible).
MVP_TOKEN_ENC_KEY=
MVP_LLM_MODE=stub
# MVP_OPENAI_API_KEY=
MVP_OPENAI_BASE_URL=https://api.openai.com/v1
MVP_OPENAI_MODEL=gpt-4o-mini
MVP_LOG_LEVEL=INFO
MVP_LOG_FORMAT=text
